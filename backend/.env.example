# 백엔드 환경변수 예시 — 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 git에 커밋하지 마세요(.gitignore 확인).

# ===== 필수 =====
NODE_ENV=production
PORT=5000

# VPS에 직접 설치한 로컬 PostgreSQL (localhost면 SSL 자동 비활성)
DATABASE_URL=postgres://velcrocat:CHANGE_ME@localhost:5432/velcrocat

# JWT 서명 키 — 반드시 긴 랜덤값으로 교체:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# 사이트 주소 (이메일 링크 / OAuth 콜백 등에 사용)
SITE_URL=https://vcat.kr

# ===== 이메일 발송 (가입/비밀번호 인증 메일) =====
MAIL_USER=
MAIL_PASS=

# ===== 네이버 로그인 (OAuth) =====
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# ⚠️ 콜백은 SPA 페이지 경로(/api 아님!). 네이버가 GET으로 리다이렉트하는 곳 = 프론트 /auth/naver/callback.
#    이 값과 "네이버 개발자센터 콘솔의 Callback URL"을 똑같이 맞춰야 함.
NAVER_CALLBACK_URL=https://vcat.kr/auth/naver/callback

# ===== 결제: 메인페이(MPC) =====
MPC_HOST=https://mpc.icu
MPC_CLIENT_ID=
MPC_CHANNEL_ID=
MPC_RETAILER_CODE=
MPC_TID=
MPC_CLIENT_SECRET=

# ===== 결제: 포트원(PortOne) — 사용하는 경우만 =====
PORTONE_REST_KEY=
PORTONE_REST_SECRET=
